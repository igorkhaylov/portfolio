# dev, test, stage, prod  (validated in settings; anything else raises on startup)
ENVIRONMENT=dev

# ------ APP ------
# Docker Compose project name (prefix for containers/volumes/networks). The dev and
# test stacks append -dev / -test automatically. Use a custom NOT COMPOSE_PROJECT_NAME
# so those per-stack suffixes are preserved.
PROJECT_NAME=portfolio
# Host port of the in-stack nginx. prod/local bind it to 127.0.0.1 only: the edge nginx
# on the host proxies igorkhaylov.uz here (8490 on the server).
APP_PORT=8050

# Backend image to PULL in prod (docker-compose.prod.yml / `make prod deploy`). CI builds
# and pushes this; the server only pulls. Pin a reproducible build with the sha- tag, e.g.
#   BACKEND_IMAGE=ghcr.io/igorkhaylov/portfolio:sha-<full-sha>
BACKEND_IMAGE=ghcr.io/igorkhaylov/portfolio:latest

# Host directory with the files the app keeps outside the containers:
#   media/   admin uploads: avatar, CV, project covers and screenshots
# Relative paths are resolved from this directory. On the server: ../data
DATA_DIR=./data

# ------ DJANGO ------
DJANGO_APP_NAME=IgorKhaylov
# REQUIRED in stage/prod (>= 50 chars). Generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=CHANGE_ME
# Comma-separated. In prod list your real domain(s). `localhost` is appended
# automatically (settings/base.py) because the container healthcheck calls
# http://localhost:8000/healthcheck/ from inside the container.
DJANGO_ALLOWED_HOSTS=localhost,backend,
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:${APP_PORT},
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:${APP_PORT},
# Logging level for the container logs (DEBUG/INFO/WARNING/ERROR).
DJANGO_LOG_LEVEL=INFO

# Used by `createsuperuserauto` in the container entrypoint (`make up` / prod) to create
# the first admin on boot (skipped when a superuser already exists). `make init`
# generates the password — read it from this file. The dev stack does not run the
# entrypoint: use `make dev createsuperuser` there.
# A placeholder value is skipped in dev and FAILS the boot in stage/prod.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# ------ GUNICORN ------
GUNICORN_WORKERS=2
# Worker request timeout in seconds (the in-stack nginx waits up to 60 s as well).
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30


# ------ POSTGRES ------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Persistent DB connection TTL in seconds; a reused connection is health-checked at
# the start of every request, so failover is immediate (this is NOT a check interval).
# Set to 0 (one connection per request) if pgbouncer in transaction mode sits in front.
# POSTGRES_CONN_MAX_AGE=600


# ------ DB BACKUP (optional, tiredofit/db-backup — prod only) ------
# Automated PostgreSQL backups to the host filesystem. DISABLED by default. Enable by
# activating the compose profile (uncomment the next line); `make prod deploy` then
# starts the db-backup service. Media is NOT covered —
# use `make prod dump media` (docs/backup.md).
# COMPOSE_PROFILES=backup
#
# Schedule + retention in MINUTES (defaults: every 24h, keep 7 days) + compression.
# DB_BACKUP_INTERVAL=1440
# DB_BACKUP_CLEANUP_TIME=10080
# DB_BACKUP_COMPRESSION=ZSTD
# DB_BACKUP_FS_PATH=./db-backups            # host path where the dumps land
#
# Override the pinned image if needed:
# DB_BACKUP_IMAGE=ghcr.io/tiredofit/docker-db-backup:4.1.100
